# Copy to .env.local for development. Only public settings; no secrets needed.

# Used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://allfresh512.com

# Leave unset/false on staging and previews (adds noindex + robots disallow).
# Set to "true" ONLY on the production deployment.
NEXT_PUBLIC_SITE_INDEXABLE=false
